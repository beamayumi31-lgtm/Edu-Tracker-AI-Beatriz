# Endereço da API, somente no servidor. O inicializador local já fornece este valor.
EDUTRACK_API_URL=http://127.0.0.1:8000
EDUTRACK_SITE_URL=http://localhost:3002

# OPENAI_API_KEY e OPENAI_MODEL devem ser configurados SOMENTE no backend.
