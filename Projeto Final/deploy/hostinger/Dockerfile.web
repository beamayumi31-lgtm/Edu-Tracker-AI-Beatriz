FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build
WORKDIR /app
RUN npm install --global pnpm@11.25.0
COPY edutrack-app-completo/ ./
RUN pnpm install --frozen-lockfile && pnpm run build:hostinger

FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/.next-hostinger/standalone/ ./
COPY --from=build --chown=node:node /app/public/ ./public/
COPY --from=build --chown=node:node /app/.next-hostinger/static/ ./.next-hostinger/static/
USER node
CMD ["node", "server.js"]
