# Copie para .env. Não compartilhe o arquivo preenchido.
EDUTRACK_ENVIRONMENT=development
EDUTRACK_SQL_SERVER=localhost\SQLEXPRESS
EDUTRACK_SQL_DATABASE=EduTrackIA
# Exceção apenas para o certificado local do SQL Express.
EDUTRACK_TRUST_SERVER_CERTIFICATE=true
# Bloqueado até autorização para gravar no banco existente.
EDUTRACK_DB_WRITES_ENABLED=false
# Chave aleatória com pelo menos 32 caracteres. Sem ela, desenvolvimento usa chave efêmera.
# EDUTRACK_JWT_SECRET=
EDUTRACK_CORS_ORIGINS=["http://localhost:3002","http://127.0.0.1:3002"]
# O agente só faz chamadas externas quando os dois valores abaixo são configurados.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Selecione somente um provedor. A chave permanece no backend.
EDUTRACK_AI_PROVIDER=openai
# Público aprovado: 13+. Bloqueia Gemini mesmo com chave, modelo e flag habilitada.
# Não habilitar outro provedor antes de implementar/revisar as proteções para adolescentes.
EDUTRACK_AI_AUDIENCE=includes_teens
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Gratuito: perguntas gerais; não envia automaticamente o contexto dos alunos.
EDUTRACK_GEMINI_PAID_SERVICE=false
EDUTRACK_GEMINI_ENABLED=false

# Ativar somente após a migração 004 e a configuração de OAuth Web no Google Cloud.
EDUTRACK_CLASSROOM_ENABLED=false
# Exige a migração 005 antes de executar esta versão e novo consentimento de leitura.
EDUTRACK_CLASSROOM_FULL_IMPORT_ENABLED=false
# EDUTRACK_GOOGLE_CLIENT_ID=
# EDUTRACK_GOOGLE_CLIENT_SECRET=
# Chave Fernet independente do JWT. Não rotacionar sem plano para os tokens já cifrados.
# EDUTRACK_INTEGRATION_ENCRYPTION_KEY=

# Confirmação real por SendGrid. Ativar apenas após aplicar migrations/001_verificacoes_email.sql.
EDUTRACK_EMAIL_VERIFICATION_ENABLED=false
# SENDGRID_API_KEY=
# EDUTRACK_EMAIL_FROM=
EDUTRACK_EMAIL_FROM_NAME=EduTrack
EDUTRACK_PASSWORD_RESET_ENABLED=false
EDUTRACK_FRONTEND_URL=http://localhost:3002
# Ativar recuperação somente após migrations/003_recuperacao_senha.sql.
# Requer EDUTRACK_JWT_SECRET persistente, remetente verificado e chave restrita a Mail Send.
